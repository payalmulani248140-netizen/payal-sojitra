<header>
    <div class="container">
        <div class="header_wrap">
            
            {% if section.settings.logo_image != blank %}
                <div class="logo">
                <img
                    src="{{ section.settings.logo_image | image_url: width: 400 }}"
                    alt="{{ section.settings.logo_image.alt | escape }}"
                    loading="lazy"
                    width="{{ section.settings.logo_image.width }}"
                    height="{{ section.settings.logo_image.height }}"
                >
                </div>
            {% endif %}

            {% if section.settings.subtext != blank %}
            <div class="subtext">
            {{ section.settings.subtext }}
            </div>
            {% endif %}

            {% if section.settings.button_label != blank %}
                <div class="right_btn">
                    <a href="{{ section.settings.button_link }}">
                    <span>{{ section.settings.button_label }}</span>

                    <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="black"/>
                    </svg>

                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</header>
<div class="custom-banner">
   {% if section.settings.banner_image != blank %}
        <div class="banner">
           

            <picture>
            {% if section.settings.banner_image_mobile != blank %}
                <source
                media="(max-width: 767px)"
                srcset="{{ section.settings.banner_image_mobile | image_url: width: 800 }}">
            {% endif %}

            <img
                src="{{ section.settings.banner_image | image_url: width: 1800 }}"
                alt="{{ section.settings.banner_image.alt | escape }}"
                loading="lazy"
                width="{{ section.settings.banner_image.width }}"
                height="{{ section.settings.banner_image.height }}">
            </picture>

           
        </div>
        {% endif %}
    <div class="custom-content">
        <div class="container">
        <div class="custom-content-wrap">
            {% if section.settings.header != blank %}
                <h1 class="banner_title">{{section.settings.header}}</h1>
                {%endif %}
            {% if section.settings.subcontent != blank %}
            <div class="custom-content-inner">
               {{  section.settings.subcontent }}
            </div>
                {%endif %}

             {% if section.settings.banner_link != blank %}
            <a href="{{ section.settings.banner_link }}" class="custom-btn">
            {% endif %}
             {% if section.settings.btn_text != blank %}
                <span>{{section.settings.btn_text}}</span>
            {% endif %}
                <svg width="64" height="26" viewBox="0 0 64 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.76563 11.2357L9.72209e-05 11.2357L9.68518e-05 14.7667L1.76562 14.7667L1.76563 11.2357ZM63.0591 14.2496C63.7485 13.5602 63.7485 12.4423 63.0591 11.7528L51.8233 0.517056C51.1338 -0.172425 50.016 -0.172426 49.3265 0.517056C48.637 1.20654 48.637 2.32441 49.3265 3.01389L59.3138 13.0012L49.3265 22.9886C48.637 23.678 48.637 24.7959 49.3265 25.4854C50.016 26.1749 51.1338 26.1749 51.8233 25.4854L63.0591 14.2496ZM1.76562 14.7667L61.8106 14.7668L61.8106 11.2357L1.76563 11.2357L1.76562 14.7667Z" fill="white"/>
                </svg>
             {% if section.settings.banner_link != blank %}
            </a>
            {% endif %}
        </div>
        </div>
    </div>
</div>

<div class="bottom_banner">
    <div class="content_bottom">
        SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
    </div>
</div>

{% schema %}
{
  "name": "Banner",
  "class": "custom-banner",
  "settings": [
    {
        "type": "header",
        "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },

    {
      "type": "richtext",
      "id": "subtext",
      "label": "Sub Text",
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Choose Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
        "type": "header",
        "content": "Banner"
    },
    {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Desktop Banner"
    },
    {
        "type": "image_picker",
        "id": "banner_image_mobile",
        "label": "Mobile Banner"
    },
    {
        "type": "text",
        "id": "header",
        "label": "Heading"
    },
      {
      "type": "richtext",
      "id": "subcontent",
      "label": "Sub Content"
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text"
    },
    {
        "type": "url",
        "id": "banner_link",
        "label": "Button Link"
    },
     {
        "type": "header",
        "content": "Bottom Content"
    },
     {
      "type": "richtext",
      "id": "bottom_content",
      "label": "Sub Content"
    },
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}