<div class="custom-product-grid">
    <div class="container">
        <div class="product-box">
            {% for block in section.blocks %}
                <div class="look-item">
                    <img src="{{ block.settings.image | image_url: width: 900 }}">

                    <button
                    class="look-icon"
                    style="
                    left:{{ block.settings.icon_x }}%;
                    top:{{ block.settings.icon_y }}%;
                    "
                    data-product="{{ all_products[block.settings.product].handle }}">
                    +
                    </button>

                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Look Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "icon_x",
          "label": "Icon Horizontal Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "icon_y",
          "label": "Icon Vertical Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}