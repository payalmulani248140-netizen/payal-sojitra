<div class="custom-product-grid">
    <div class="container">
        <div class="product-box">
            {% for block in section.blocks %}
                <div class="look-item">

                    {%- if block.settings.image != blank -%}
                        <img
                            src="{{ block.settings.image | image_url: width: 900 }}"
                            srcset="
                            {{ block.settings.image | image_url: width: 375 }} 375w,
                            {{ block.settings.image | image_url: width: 550 }} 550w,
                            {{ block.settings.image | image_url: width: 750 }} 750w,
                            {{ block.settings.image | image_url: width: 900 }} 900w,
                            {{ block.settings.image | image_url: width: 1200 }} 1200w,
                            {{ block.settings.image | image_url: width: 1500 }} 1500w,
                            {{ block.settings.image | image_url: width: 1800 }} 1800w
                            "
                            sizes="100vw"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="eager"
                            fetchpriority="high"
                        >
                        {%- endif -%}

                    <button
                    class="look-icon"
                    style="
                    left:{{ block.settings.icon_x }}%;
                    top:{{ block.settings.icon_y }}%;
                    "
                    data-product="{{ all_products[block.settings.product].handle }}">
                    +
                    </button>

                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Look Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "icon_x",
          "label": "Icon Horizontal Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "icon_y",
          "label": "Icon Vertical Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}